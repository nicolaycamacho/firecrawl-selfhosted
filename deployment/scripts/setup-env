#!/usr/bin/env python3
"""Create local deployment secrets once, without printing them."""
import os
from pathlib import Path
import secrets

root = Path(__file__).resolve().parents[2]
os.umask(0o077)
(root / '.local').mkdir(exist_ok=True)
target = root / '.local/compose.env'
try:
    with target.open('x') as stream:
        stream.write(f'POSTGRES_PASSWORD={secrets.token_hex(32)}\n')
        stream.write(f'BULL_AUTH_KEY={secrets.token_hex(32)}\n')
except FileExistsError:
    pass
target.chmod(0o600)
print('Local Compose environment ready (secrets not displayed).')
